<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_ring">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal"
        android:orientation="vertical" android:paddingStart="28dp" android:paddingTop="38dp" android:paddingEnd="28dp" android:paddingBottom="22dp">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="@null"
            android:src="@android:drawable/ic_lock_idle_alarm" app:tint="@color/white" />
        <TextView android:id="@+id/ringTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="@string/time_preview" android:textColor="@color/white" android:textSize="72sp" android:textStyle="bold" />
        <TextView android:id="@+id/ringLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/alarm" android:textColor="#E9DDFF" android:textSize="22sp" />
        <LinearLayout android:id="@+id/mathPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/solve_to_dismiss" android:textColor="@color/navy" android:textStyle="bold" />
            <TextView android:id="@+id/mathQuestion" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:padding="12dp" android:text="@string/math_preview" android:textColor="@color/primary_dark" android:textSize="30sp" android:textStyle="bold" />
            <EditText android:id="@+id/mathAnswer" android:layout_width="match_parent" android:layout_height="54dp"
                android:gravity="center" android:hint="@string/enter_answer" android:inputType="numberSigned" />
            <TextView android:id="@+id/mathError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="@color/danger" />
            <com.google.android.material.button.MaterialButton android:id="@+id/checkMathButton"
                android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp"
                android:text="@string/check_answer" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/snoozeButton"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="54dp"
            android:text="@string/snooze_5" android:textSize="16sp" />
        <TextView android:id="@+id/swipeHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="@string/swipe_up_to_dismiss"
            android:textColor="#E6FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        <FrameLayout android:id="@+id/dismissGesture" android:layout_width="match_parent" android:layout_height="158dp"
            android:layout_marginTop="2dp" android:contentDescription="@string/swipe_up_to_dismiss">
            <ImageView android:id="@+id/swipeArrow" android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp"
                android:alpha="0.72" android:contentDescription="@null"
                android:src="@drawable/ic_chevron_up_material" app:tint="@color/white" />
            <FrameLayout android:id="@+id/swipeThumb" android:layout_width="76dp" android:layout_height="76dp"
                android:layout_gravity="bottom|center_horizontal" android:background="@drawable/bg_swipe_thumb"
                android:elevation="6dp">
                <ImageView android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_gravity="center" android:contentDescription="@null"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" app:tint="@color/white" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
